{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/admin/(.*)", "destination": "/admin.html" },
    { "source": "/login/(.*)", "destination": "/login.html" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ]
}

